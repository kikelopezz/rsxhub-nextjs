// RSX — esquema Postgres, migrado desde Firestore.
// IDs: String @id sin @default() salvo donde se indique — el script de migración
// inserta los IDs originales de Firestore tal cual; filas nuevas post-corte deben
// generar su propio id (cuid()) en la capa de aplicación salvo que se indique lo contrario.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ============================================================
// Identidad / Auth
// ============================================================
// Nota: no existe tabla "steam_id_index" — en Firestore era un workaround para
// evitar condiciones de carrera al buscar por steamId; en Postgres el índice
// único de SteamAccount.steamId + una transacción real lo resuelve sin tabla aparte.

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  steamAccount  SteamAccount?
  profile       Profile?
  platformRoles PlatformRole[]
  leagueMembers LeagueMember[]
  teamMembers   TeamMember[]

  @@map("users")
}

model SteamAccount {
  userId           String   @id @map("user_id")
  steamId          String   @unique @map("steam_id")
  steamDisplayName String   @map("steam_display_name")
  steamAvatarUrl   String?  @map("steam_avatar_url")
  steamProfileUrl  String?  @map("steam_profile_url")
  createdAt        DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("steam_accounts")
}

enum Simulator {
  ac
  lmu
}

model Profile {
  userId              String    @id @map("user_id")
  displayName         String    @map("display_name")
  mainSim             Simulator @default(ac) @map("main_sim")
  avatarUrl           String?   @map("avatar_url")
  countryCode         String    @default("ES") @map("country_code")
  bio                 String    @default("")
  onboarded           Boolean   @default(false)
  preferredCategories String[]  @map("preferred_categories")
  racingNumber        Int?      @map("racing_number")
  isPublic            Boolean   @default(true) @map("is_public")
  bannerUrl           String?   @map("banner_url")
  accentColor         String?   @map("accent_color")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

enum PlatformRoleValue {
  user
  steward
  platform_admin
  super_admin
}

model PlatformRole {
  id        String            @id @default(cuid())
  userId    String            @map("user_id")
  role      PlatformRoleValue
  createdAt DateTime          @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("platform_roles")
}

model AdminGrant {
  steamId         String   @id @map("steam_id")
  grantedByUserId String   @map("granted_by_user_id")
  grantedByName   String   @map("granted_by_name")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("admin_grants")
}

// ============================================================
// Ligas
// ============================================================

enum LeagueFormat {
  sprint
  endurance
  gt3
  prototype
  formula
  multiclass
}

enum LeagueStatus {
  draft
  open
  ongoing
  finished
}

enum RegistrationMode {
  individual
  team
}

model League {
  id               String           @id @default(cuid())
  title            String
  slug             String           @unique
  shortDescription String           @default("") @map("short_description")
  fullDescription  String           @default("") @map("full_description")
  simulator        Simulator
  format           LeagueFormat
  classTags        String[]         @map("class_tags")
  status           LeagueStatus     @default(draft)
  bannerUrl        String?          @map("banner_url")
  logoUrl          String?          @map("logo_url")
  startsAt         DateTime?        @map("starts_at")
  endsAt           DateTime?        @map("ends_at")
  isFeatured       Boolean          @default(false) @map("is_featured")
  registrationOpen Boolean          @default(false) @map("registration_open")
  registrationMode RegistrationMode @default(individual) @map("registration_mode")
  accentColor      String?          @map("accent_color")
  slogan           String?
  discordUrl       String?          @map("discord_url")
  youtubeUrl       String?          @map("youtube_url")
  rulebookUrl      String?          @map("rulebook_url")
  createdAt        DateTime         @default(now()) @map("created_at")

  classLimits        LeagueClassLimit[]
  events             LeagueEvent[]
  members            LeagueMember[]
  registrations      LeagueRegistration[]
  teamRegistrations  LeagueTeamRegistration[]
  eventConfirmations LeagueEventConfirmation[]
  results            LeagueResult[]
  resultImports      LeagueResultImport[]
  teamPoints         LeagueTeamPoints[]
  leagueCars         LeagueCar[]
  teams              Team[]

  @@map("leagues")
}

// Unifica classLimits de liga (eventId = null) y de evento (eventId set).
model LeagueClassLimit {
  id       String  @id @default(cuid())
  leagueId String  @map("league_id")
  eventId  String? @map("event_id")
  classTag String  @map("class_tag")
  maxCars  Int     @map("max_cars")

  league League       @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  event  LeagueEvent? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([leagueId, eventId, classTag])
  @@map("league_class_limits")
}

model Circuit {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  imageUrl  String   @map("image_url")
  isSystem  Boolean  @default(false) @map("is_system")
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  events LeagueEvent[]

  @@map("circuits")
}

enum EventStatus {
  scheduled
  completed
  cancelled
}

enum EventType {
  race
  qualifying
  time_attack
}

model LeagueEvent {
  id              String      @id @default(cuid())
  leagueId        String      @map("league_id")
  circuitId       String?     @map("circuit_id")
  title           String?
  circuitName     String      @map("circuit_name")
  circuitImageUrl String?     @map("circuit_image_url")
  serverLink      String?     @map("server_link")
  hasQualy        Boolean     @default(true) @map("has_qualy")
  qualyStartsAt   DateTime?   @map("qualy_starts_at")
  qualyEndsAt     DateTime?   @map("qualy_ends_at")
  startsAt        DateTime    @map("starts_at")
  endsAt          DateTime    @map("ends_at")
  status          EventStatus @default(scheduled)
  eventType       EventType   @default(race) @map("event_type")
  countryCode     String?     @map("country_code")
  color           String?
  maxDrivers      Int?        @map("max_drivers")
  qualyCompleted  Boolean     @default(false) @map("qualy_completed")
  completedAt     DateTime?   @map("completed_at")
  createdAt       DateTime    @default(now()) @map("created_at")

  league        League                    @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  circuit       Circuit?                  @relation(fields: [circuitId], references: [id], onDelete: SetNull)
  classLimits   LeagueClassLimit[]
  confirmations LeagueEventConfirmation[]
  results       LeagueResult[]
  resultImports LeagueResultImport[]

  @@map("league_events")
}

model LeagueCar {
  id        String   @id @default(cuid())
  leagueId  String   @map("league_id")
  label     String
  model     String
  classTag  String?  @map("class_tag")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@map("league_cars")
}

enum LeagueRoleValue {
  league_owner
  league_admin
  steward
  team_manager
  driver
}

model LeagueMember {
  id        String          @id @default(cuid())
  leagueId  String          @map("league_id")
  userId    String          @map("user_id")
  role      LeagueRoleValue @default(driver)
  createdAt DateTime        @default(now()) @map("created_at")

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leagueId, userId])
  @@map("league_members")
}

// ============================================================
// Inscripciones / confirmaciones / resultados
// ============================================================

enum RegistrationStatus {
  pending
  approved
  rejected
  waitlist
}

// Nota: "un numero de coche por clase/liga" NO es una constraint de DB — un
// mismo coche con varios pilotos genera a proposito varias filas con el
// mismo (league_id, class_tag, assigned_number), una por piloto. La regla
// real ("ese numero ya lo tiene OTRO equipo") se aplica en la capa de app,
// igual que hacia contra Firestore.
model LeagueRegistration {
  id             String             @id @default(cuid())
  leagueId       String             @map("league_id")
  userId         String             @map("user_id")
  teamId         String?            @map("team_id")
  displayName    String             @map("display_name")
  steamId        String?            @map("steam_id")
  classTag       String?            @map("class_tag")
  assignedNumber Int?               @map("assigned_number")
  status         RegistrationStatus @default(pending)
  createdAt      DateTime           @default(now()) @map("created_at")

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  team   Team?  @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@map("league_registrations")
}

enum TeamRegStatus {
  pending
  approved
  rejected
}

model LeagueTeamRegistration {
  id              String        @id @default(cuid())
  leagueId        String        @map("league_id")
  teamId          String        @map("team_id")
  classTag        String?       @map("class_tag")
  carNumber       Int           @map("car_number")
  carModel        String?       @map("car_model")
  status          TeamRegStatus @default(pending)
  createdByUserId String        @map("created_by_user_id")
  createdAt       DateTime      @default(now()) @map("created_at")

  league  League                         @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  team    Team                           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  drivers LeagueTeamRegistrationDriver[]

  @@unique([leagueId, teamId, classTag, carNumber])
  @@map("league_team_registrations")
}

model LeagueTeamRegistrationDriver {
  id                 String @id @default(cuid())
  teamRegistrationId String @map("team_registration_id")
  userId             String @map("user_id")
  assignedNumber     Int?   @map("assigned_number")

  teamRegistration LeagueTeamRegistration @relation(fields: [teamRegistrationId], references: [id], onDelete: Cascade)

  @@unique([teamRegistrationId, userId])
  @@map("league_team_registration_drivers")
}

model LeagueEventConfirmation {
  id          String   @id @default(cuid())
  eventId     String   @map("event_id")
  leagueId    String   @map("league_id")
  teamId      String   @map("team_id")
  classTag    String   @map("class_tag")
  carNumber   Int      @map("car_number")
  carModel    String?  @map("car_model")
  confirmedAt DateTime @default(now()) @map("confirmed_at")

  event   LeagueEvent               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  league  League                    @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  team    Team                      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  drivers EventConfirmationDriver[]

  @@unique([eventId, teamId, classTag, carNumber])
  @@map("league_event_confirmations")
}

model EventConfirmationDriver {
  id             String @id @default(cuid())
  confirmationId String @map("confirmation_id")
  userId         String @map("user_id")

  confirmation LeagueEventConfirmation @relation(fields: [confirmationId], references: [id], onDelete: Cascade)

  @@unique([confirmationId, userId])
  @@map("event_confirmation_drivers")
}

enum SessionType {
  qualifying
  race
}

enum ResultStatus {
  finished
  dnf
  dsq
}

model LeagueResult {
  id          String       @id @default(cuid())
  leagueId    String       @map("league_id")
  eventId     String       @map("event_id")
  userId      String       @map("user_id")
  sessionType SessionType  @default(race) @map("session_type")
  position    Int?
  points      Int?
  status      ResultStatus @default(finished)
  driverName  String?      @map("driver_name")
  teamName    String?      @map("team_name")
  steamId     String?      @map("steam_id")
  classTag    String?      @map("class_tag")
  dorsal      String?
  lapTime     String?      @map("lap_time")
  raceTime    String?      @map("race_time")
  createdAt   DateTime     @default(now()) @map("created_at")

  league League      @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  event  LeagueEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("league_results")
}

model LeagueResultImport {
  id                String   @id @default(cuid())
  leagueId          String   @map("league_id")
  eventId           String   @map("event_id")
  uploadedByUserId  String   @map("uploaded_by_user_id")
  fileName          String   @map("file_name")
  payloadText       String   @map("payload_text")
  rowsTotal         Int      @map("rows_total")
  rowsImported      Int      @map("rows_imported")
  rowsUnresolved    Int      @map("rows_unresolved")
  rowsNotRegistered Int      @map("rows_not_registered")
  createdAt         DateTime @default(now()) @map("created_at")

  league League      @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  event  LeagueEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("league_result_imports")
}

model LeagueTeamPoints {
  id        String   @id @default(cuid())
  leagueId  String   @map("league_id")
  classTag  String   @map("class_tag")
  teamId    String   @map("team_id")
  // Points belong to a specific car, not the team as a whole — a team running two cars in
  // the same class must be able to score them independently. Empty string covers rows from
  // before this field existed / teams with no assigned car number.
  carNumber String   @default("") @map("car_number")
  points    Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([leagueId, classTag, teamId, carNumber])
  @@map("league_team_points")
}

model DriverNumberPreference {
  id       String @id @default(cuid())
  userId   String @map("user_id")
  classTag String @map("class_tag")
  priority Int
  number   Int

  @@unique([userId, classTag, priority])
  @@map("driver_number_preferences")
}

// ============================================================
// Equipos
// ============================================================

enum TeamStatus {
  pending
  approved
  rejected
}

model Team {
  id             String     @id @default(cuid())
  leagueId       String?    @map("league_id")
  name           String
  description    String?
  classTags      String[]   @map("class_tags")
  primaryColor   String?    @map("primary_color")
  secondaryColor String?    @map("secondary_color")
  accentColor    String?    @map("accent_color")
  slogan         String?
  discordUrl     String?    @map("discord_url")
  youtubeUrl     String?    @map("youtube_url")
  instagramUrl   String?    @map("instagram_url")
  twitterUrl     String?    @map("twitter_url")
  twitchUrl      String?    @map("twitch_url")
  tiktokUrl      String?    @map("tiktok_url")
  logoUrl        String?    @map("logo_url")
  bannerUrl      String?    @map("banner_url")
  carSkinUrls    String[]   @map("car_skin_urls")
  ownerUserId    String     @map("owner_user_id")
  maxSlots       Int?       @map("max_slots")
  status         TeamStatus @default(pending)
  createdAt      DateTime   @default(now()) @map("created_at")

  league             League?                   @relation(fields: [leagueId], references: [id], onDelete: SetNull)
  cars               TeamCar[]
  skinAssignments    TeamSkinAssignment[]
  members            TeamMember[]
  invites            TeamInvite[]
  registrations      LeagueRegistration[]
  teamRegistrations  LeagueTeamRegistration[]
  eventConfirmations LeagueEventConfirmation[]
  teamPoints         LeagueTeamPoints[]
  marketListings     MarketListing[]
  marketApplications MarketApplication[]

  @@map("teams")
}

model TeamCar {
  id          String   @id @default(cuid())
  teamId      String   @map("team_id")
  category    String
  dorsal      String
  modelName   String?  @map("model_name")
  modelFolder String?  @map("model_folder")
  skinUrl     String?  @map("skin_url")
  skinName    String?  @map("skin_name")
  leagueId    String?  @map("league_id")
  createdAt   DateTime @default(now()) @map("created_at")

  team    Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  drivers TeamCarDriver[]

  @@map("team_cars")
}

// leagueId = null -> lista de pilotos por defecto del coche (driverUserIds original).
// leagueId set -> override especifico de esa liga (driverUserIdsByLeague original).
model TeamCarDriver {
  id        String  @id @default(cuid())
  carId     String  @map("car_id")
  userId    String  @map("user_id")
  leagueId  String? @map("league_id")
  // A reserve driver is part of the car's lineup but doesn't occupy one of the regular
  // driving slots — kept as the same kind of row (car+league+user) as a regular driver,
  // just flagged, rather than a separate table.
  isReserve Boolean @default(false) @map("is_reserve")

  car TeamCar @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@unique([carId, userId, leagueId, isReserve])
  @@map("team_car_league_drivers")
}

// Un registro por cada vez que se guarda una alineación de un coche — usado para
// aplicar el límite de 3 cambios de alineación por coche y día.
model LineupChangeLog {
  id          String   @id @default(cuid())
  carId       String   @map("car_id")
  teamId      String   @map("team_id")
  changedById String   @map("changed_by_id")
  changedAt   DateTime @default(now()) @map("changed_at")

  @@index([carId, changedAt])
  @@map("lineup_change_logs")
}

model TeamSkinAssignment {
  id         String   @id @default(cuid())
  teamId     String   @map("team_id")
  leagueSlug String   @map("league_slug")
  carNumber  String?  @map("car_number")
  skinUrl    String   @map("skin_url")
  featured   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("team_skin_assignments")
}

enum TeamRoleValue {
  owner
  manager
  driver
}

model TeamMember {
  id          String        @id @default(cuid())
  teamId      String        @map("team_id")
  userId      String        @map("user_id")
  role        TeamRoleValue
  // Free-form specialty badges (team leader, team boss, engineer, HYPERCAR/GT3/LMP2 driver…),
  // separate from `role` above which only gates team-management permissions — a member can
  // hold any combination of these at once.
  roleTags    String[]      @default([]) @map("role_tags")
  displayName String?       @map("display_name")
  steamId     String?       @map("steam_id")
  avatarUrl   String?       @map("avatar_url")
  createdAt   DateTime      @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

enum TeamInviteStatus {
  pending
  accepted
  rejected
}

// Cubre tambien el flujo de invitacion desde el mercado (campo listingId) —
// la coleccion Firestore "market_invites" resulto ser vestigial/no usada en la
// practica; el flujo real de invitar desde un anuncio ya escribe aqui.
model TeamInvite {
  id              String           @id @default(cuid())
  teamId          String           @map("team_id")
  invitedByUserId String           @map("invited_by_user_id")
  invitedUserId   String?          @map("invited_user_id")
  invitedSteamId  String?          @map("invited_steam_id")
  message         String?
  status          TeamInviteStatus @default(pending)
  listingId       String?          @map("listing_id")
  createdAt       DateTime         @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("team_invites")
}

// ============================================================
// Mercado / notificaciones / config
// ============================================================

enum MarketListingType {
  team_seeking_driver
  driver_seeking_team
}

model MarketListing {
  id          String            @id @default(cuid())
  type        MarketListingType
  userId      String            @map("user_id")
  userName    String            @map("user_name")
  userAvatar  String?           @map("user_avatar")
  countryCode String?           @map("country_code")
  teamId      String?           @map("team_id")
  teamName    String?           @map("team_name")
  teamLogo    String?           @map("team_logo")
  title       String
  description String
  mainSim     Simulator         @map("main_sim")
  classTag    String            @map("class_tag")
  contactInfo String            @map("contact_info")
  createdAt   DateTime          @default(now()) @map("created_at")

  team         Team?               @relation(fields: [teamId], references: [id], onDelete: SetNull)
  applications MarketApplication[]

  @@map("market_listings")
}

enum MarketApplicationStatus {
  pending
  accepted
  declined
}

model MarketApplication {
  id          String                  @id @default(cuid())
  listingId   String                  @map("listing_id")
  teamId      String?                 @map("team_id")
  userId      String                  @map("user_id")
  userName    String                  @map("user_name")
  userAvatar  String?                 @map("user_avatar")
  contactInfo String                  @map("contact_info")
  status      MarketApplicationStatus @default(pending)
  message     String?
  createdAt   DateTime                @default(now()) @map("created_at")

  listing MarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  team    Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@map("market_applications")
}

model UserNotification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  message   String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("user_notifications")
}

// Reemplaza el uso de Firestore como KV store (settings/deleted_assets, settings/gallery_uploads).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// Etiquetas informativas que un admin añade a un día del calendario (fechas de
// entrega de skins, eventos fuera de pista...), independientes de los eventos de liga.
model CalendarNote {
  id        String   @id @default(cuid())
  date      DateTime
  title     String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("calendar_notes")
}

model NewsPost {
  id          String   @id @default(cuid())
  title       String
  excerpt     String
  body        String
  imageUrl    String?  @map("image_url")
  authorId    String?  @map("author_id")
  publishedAt DateTime @default(now()) @map("published_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("news_posts")
}
