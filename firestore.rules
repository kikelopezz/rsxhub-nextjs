rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Local emulator only: the app talks to Firestore exclusively through
    // the Admin SDK (server-side), which bypasses these rules entirely.
    // Wide open here just so the emulator boots without complaint.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
