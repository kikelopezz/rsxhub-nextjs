rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The app no longer uses Firestore at all (migrated to Postgres via Prisma —
    // lib/firebase.ts / lib/firebase-client.ts have zero importers). Deny by default:
    // if this project's Firestore is ever touched again, whoever does it should have
    // to write real rules for whatever they're adding, not inherit "open to everyone".
    // NOTE: this file only affects what gets deployed the next time someone runs
    // `firebase deploy --only firestore:rules` — check the Firebase console directly
    // for what's live on the actual project right now.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
