# Admin settings
ADMIN_STEAM_IDS=

# Cloudflare R2 configuration (Server) — image/skin uploads.
# Get R2_ACCOUNT_ID from the R2 overview page, and the access keys from
# R2 > Manage R2 API Tokens > Create API Token (Object Read & Write, scoped to the bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL for the bucket: either the r2.dev subdomain (Bucket > Settings > Public access)
# or a custom domain connected to the bucket. No trailing slash.
R2_PUBLIC_URL=

# Bot de soporte de Discord (sección /soporte) — corre dentro de este mismo proceso
# (ver instrumentation.ts), sin bot ni base de datos aparte. Sin token, /soporte sigue
# existiendo pero avisa de que el bot no está configurado.
# Token del bot (Discord Developer Portal > tu aplicación > Bot > Reset Token).
DISCORD_BOT_TOKEN=

# Session configuration
SESSION_SECRET=

# Steam Login configuration
STEAM_REALM=
STEAM_RETURN_URL=
STEAM_WEB_API_KEY=
# Steam login only ever redirects to / accepts origins on this allow-list: NEXT_PUBLIC_APP_URL, STEAM_REALM,
# STEAM_RETURN_URL, COMPETITION_PUBLIC_URL and (on Vercel) the deployment URLs. Put the public domain in
# NEXT_PUBLIC_APP_URL; list any extra domains here, comma-separated (e.g. https://rsxhub.com,https://www.rsxhub.com).
ALLOWED_AUTH_ORIGINS=

# API interna de competicion (bot RSX Competition y futuros servicios). Genera una clave larga y aleatoria.
RSX_COMPETITION_API_KEY=
# Opcional: URL publica del Hub para construir enlaces (si no, se usa NEXT_PUBLIC_APP_URL o el origen de la peticion).
COMPETITION_PUBLIC_URL=
