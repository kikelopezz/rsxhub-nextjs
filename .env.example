# Admin settings
ADMIN_STEAM_IDS=

# Firebase Admin configuration (Server) — this is the only Firebase config actually used.
# Get these from Firebase Console > Project Settings > Service accounts > Generate new private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase configuration (Client) — optional, only needed if a client-side Firebase SDK
# usage is added later. Not required for the app to run against real Firebase data.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Cloudflare R2 configuration (Server) — image/skin uploads.
# Get R2_ACCOUNT_ID from the R2 overview page, and the access keys from
# R2 > Manage R2 API Tokens > Create API Token (Object Read & Write, scoped to the bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL for the bucket: either the r2.dev subdomain (Bucket > Settings > Public access)
# or a custom domain connected to the bucket. No trailing slash.
R2_PUBLIC_URL=

# Session configuration
SESSION_SECRET=

# Steam Login configuration
STEAM_REALM=
STEAM_RETURN_URL=
STEAM_WEB_API_KEY=
