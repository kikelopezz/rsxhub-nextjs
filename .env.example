# Base de datos Postgres de producción (Prisma). ALTO IMPACTO si se filtra: acceso de lectura y
# escritura a todos los datos del Hub.
DATABASE_URL=

# Admin settings. Lista de SteamID64 separados por coma que arrancan como super_admin sin que
# nadie tenga que concedérselo desde el panel (acceso de recuperación/bootstrap).
ADMIN_STEAM_IDS=

# Cloudflare R2 configuration (Server) — image/skin uploads.
# Get R2_ACCOUNT_ID from the R2 overview page, and the access keys from
# R2 > Manage R2 API Tokens > Create API Token (Object Read & Write, scoped to the bucket).
# ALTO IMPACTO si R2_SECRET_ACCESS_KEY se filtra: acceso de escritura a todo el bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL for the bucket: either the r2.dev subdomain (Bucket > Settings > Public access)
# or a custom domain connected to the bucket. No trailing slash.
R2_PUBLIC_URL=

# Bot de soporte de Discord (sección /soporte) — proceso APARTE (proyecto hermano "rsx ticket"),
# el Hub solo le habla por esta API HTTP interna. ALTO IMPACTO si SUPPORT_BOT_API_KEY se filtra:
# permite leer/escribir tickets de soporte vía el bot.
SUPPORT_BOT_URL=
SUPPORT_BOT_API_KEY=

# Session configuration. ALTO IMPACTO si se filtra: firma las sesiones (JWT) — con este secreto se
# puede forjar una sesión de cualquier usuario, incluido un super_admin, sin tocar la base de datos.
SESSION_SECRET=

# Steam Login configuration
STEAM_REALM=
STEAM_RETURN_URL=
STEAM_WEB_API_KEY=
# Steam login only ever redirects to / accepts origins on this allow-list: NEXT_PUBLIC_APP_URL, STEAM_REALM,
# STEAM_RETURN_URL, COMPETITION_PUBLIC_URL and (on Vercel) the deployment URLs. Put the public domain in
# NEXT_PUBLIC_APP_URL; list any extra domains here, comma-separated (e.g. https://rsxhub.com,https://www.rsxhub.com).
ALLOWED_AUTH_ORIGINS=
NEXT_PUBLIC_APP_URL=
# Alias que también se lee en algún sitio en vez de NEXT_PUBLIC_APP_URL; mantenlas iguales.
NEXT_PUBLIC_SITE_URL=
APP_URL=

# API interna de competicion (bot RSX Competition y futuros servicios). ALTO IMPACTO si se filtra:
# permite leer datos internos de ligas/eventos/resultados vía esa API. Genera una clave larga y aleatoria.
RSX_COMPETITION_API_KEY=
# Opcional: URL publica del Hub para construir enlaces (si no, se usa NEXT_PUBLIC_APP_URL o el origen de la peticion).
COMPETITION_PUBLIC_URL=

# Live timing (Assetto Corsa Server Manager) que consumen /api/live-timing/** y /live-timing —
# son endpoints públicos sin autenticación a propósito (los consume cada pestaña abierta).
NEXT_PUBLIC_LIVE_TIMING_API_URL=
NEXT_PUBLIC_LIVE_TIMING_API_URL_ERC_NEXT_GEN=

# Residuales de una migración anterior (Supabase ya no se usa como fuente de datos activa, solo
# queda referenciado en un par de sitios menores) — se pueden dejar vacías salvo que algo las necesite.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
